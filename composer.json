{
    "name": "solution25/typo3-ai-connector",
    "type": "typo3-cms-extension",
    "description": "AI connector - Connects a TYPO3 site to AI clients such as Claude through the Solution25 MCP gateway.",
    "license": "proprietary",
    "keywords": [
        "ai",
        "mcp",
        "claude",
        "connector",
        "llm"
    ],
    "authors": [
        {
            "name": "Solution25",
            "role": "Developer"
        }
    ],
    "support": {
        "source": "https://bitbucket.org/solution-25/mcp-service-typo3-connector-plugin"
    },
    "require": {
        "php": "^8.2",
        "typo3/cms-backend": "^13.4 || ^14.3",
        "typo3/cms-core": "^13.4 || ^14.3",
        "typo3/cms-seo": "^13.4 || ^14.3"
    },
    "require-dev": {
        "typo3/coding-standards": "^0.9",
        "typo3/tailor": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "Solution25\\AiConnector\\": "Classes/"
        }
    },
    "config": {
        "allow-plugins": {
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "ai_connector",
            "Package": {
                "providesPackages": {}
            }
        }
    },
    "scripts": {
        "cs:check": "php-cs-fixer fix --dry-run --diff --config=.php-cs-fixer.dist.php",
        "cs:fix": "php-cs-fixer fix --config=.php-cs-fixer.dist.php"
    }
}
